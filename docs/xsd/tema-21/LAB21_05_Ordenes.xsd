<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Ordenes">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Orden" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ordenId" type="xs:string"/>
              <xs:element name="cliente" type="xs:string"/>
              <xs:element name="monto" type="xs:decimal"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
